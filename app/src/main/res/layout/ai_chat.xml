<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070A">

    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/gradient_glow_top" />

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#CC1A1E2E">

        <TextView
            android:id="@+id/systemStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM: CORE_LINK_ACTIVE"
            android:textColor="#00D4FF"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="#3300D4FF" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@+id/inputArea"
        android:padding="8dp"
        android:scrollbarThumbVertical="@null" />

    <LinearLayout
        android:id="@+id/inputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1A1E2E"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/aiQueryInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bot_bubble_neon"
            android:fontFamily="monospace"
            android:hint="[Enter Query...]"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#44FFFFFF"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/sendAiQuery"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/round_button_glow"
            android:src="@android:drawable/ic_menu_send"
            app:tint="#00D4FF"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/button_click_scale"
            tools:ignore="SpeakableTextPresentCheck" />
    </LinearLayout>

</RelativeLayout>