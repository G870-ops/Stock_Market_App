<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:padding="24dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@drawable/gradient_glow_top"
        android:alpha="0.4"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/round_button_glow" />

            <ImageView
                android:id="@+id/syncIcon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@android:drawable/stat_notify_sync"
                app:tint="#00D4FF" />
        </FrameLayout>

        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.3"
            android:text="NEO-EXCHANGE"
            android:textColor="#4CAF50"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60dp"
            android:fontFamily="monospace"
            android:text="QUANTUM ANALYSIS ACTIVE"
            android:textColor="#00D4FF"
            android:textSize="12sp"
            android:alpha="0.7"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoToMain"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="monospace"
            android:text="ACCESS TERMINAL"
            android:textColor="#00D4FF"
            app:cornerRadius="4dp"
            app:strokeColor="#B400D4FF"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoToChat"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:fontFamily="monospace"
            android:text="INITIALIZE AI"
            android:textColor="#020617"
            android:textStyle="bold"
            app:backgroundTint="#D800D4FF"
            app:cornerRadius="4dp"
            app:elevation="8dp"
            app:rippleColor="#FFFFFF" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#00E676"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="CORE SECURE | ENCRYPTION: AES-256"
            android:textColor="#C7FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

</RelativeLayout>