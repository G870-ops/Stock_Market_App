<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070A"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/devSignature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CORE_DEV // GOUTAM GUPTA"
        android:textColor="#8000D4FF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.3"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="monospace" />

    <LinearLayout
        android:id="@+id/marketHeaderPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/devSignature"
        android:layout_marginTop="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEO-EXCHANGE"
                android:textColor="#00D4FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:fontFamily="monospace"
                android:layout_centerVertical="true"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/themeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:thumbTint="@color/white"
                app:trackTint="#00D4FF" />
        </RelativeLayout>

        <TextView
            android:id="@+id/totalBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="33,922.26"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/priceDeltaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-366.38 [-1.07%]"
            android:textColor="#FF5252"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/sentimentScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Market Sentiment: Analyzing..."
            android:textColor="#64748B"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/hardwareMonitorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="SYS_HEALTH // MEM_OK"
            android:textColor="#00E676"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:fontFamily="monospace" />

        <LinearLayout
            android:id="@+id/timeSelectorRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:background="#121620"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1-DAY"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:padding="8dp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2-DAY"
                android:textColor="#00D4FF"
                android:background="#1E293B"
                android:textSize="11sp"
                android:padding="8dp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1-WEEK"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:padding="8dp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/marketChart"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_below="@id/marketHeaderPanel"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/labelMarket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/marketChart"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        android:letterSpacing="0.2"
        android:minHeight="48dp"
        android:padding="12dp"
        android:text="LIVE MARKET"
        android:textColor="#00D4FF"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:background="?android:attr/selectableItemBackground" />

    <TextView
        android:id="@+id/newsTicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1A00D4FF"
        android:padding="8dp"
        android:text="BREAKING: NEO-EXCHANGE HITS ALL TIME HIGH... MARKET VOLATILITY INCREASES..."
        android:textColor="#00D4FF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stockRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/labelMarket"
        android:layout_above="@id/newsTicker"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</RelativeLayout>